# Task 6.6 — copy to .env, edit locally; NEVER commit .env or pass keys in CLI arguments.
# Loading is explicit: python scripts/query_retrieval_smoke.py --env-file .env ...
# Existing process environment wins over this file. No shell expansion/command execution.

# DeepSeek's OpenAI-compatible Chat Completions endpoint (not an OpenAI-hosted service).
ERAG_LLM_PROVIDER=deepseek
ERAG_LLM_BASE_URL=https://api.deepseek.com
# Required: replace the empty value ONLY in your local .env.
ERAG_LLM_API_KEY=
# Illustrative model from current DeepSeek documentation; confirm account availability.
# No model is hard-coded in the adapter; set the exact model your account can access.
ERAG_LLM_MODEL=deepseek-flash
# Leave empty unless the remote response actually provides this verifiable revision.
ERAG_LLM_MODEL_REVISION=
# Each generate() makes ONE HTTP attempt. No hidden transport retries.
# MAX_ATTEMPTS is the shared per-stage Understanding/Rewrite attempt limit (1 or 2).
ERAG_LLM_TIMEOUT_SECONDS=30
ERAG_LLM_MAX_ATTEMPTS=2
ERAG_LLM_TEMPERATURE=0
ERAG_LLM_MAX_OUTPUT_TOKENS=2048
# DeepSeek: json_object + JSON instructions + local Pydantic validation.
# json_schema is opt-in ONLY for another endpoint with verified native support.
ERAG_LLM_RESPONSE_FORMAT=json_object
ERAG_LLM_TOKEN_PARAMETER=max_tokens
ERAG_LLM_SEND_TEMPERATURE=true
# Empty = response.model must equal MODEL. Explicit comma-separated aliases only.
# Do not add a different semantic model to make an identity mismatch disappear.
ERAG_LLM_RESPONSE_MODEL_IDS=

# Existing retrieval modules' environment names (read-only smoke; no auto indexing).
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=
# Existing Task 2/3 GB50010 snapshot in this development environment; change for your corpus.
ENGINEERING_RAG_KEYWORD_INDEX=engineering-rag-gb50010-v6
ENGINEERING_RAG_ES_REQUEST_TIMEOUT=30
ENGINEERING_RAG_ES_ANALYZER=standard
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
ENGINEERING_RAG_VECTOR_COLLECTION=engineering_rag_gb50010_full_v6
ENGINEERING_RAG_MILVUS_TIMEOUT=30

# MUST match the existing Milvus collection description, including revision/instruction.
ENGINEERING_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ENGINEERING_RAG_EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
ENGINEERING_RAG_EMBEDDING_DEVICE=cpu
ENGINEERING_RAG_EMBEDDING_DIMENSION=512
ENGINEERING_RAG_EMBEDDING_BATCH_SIZE=32
# Optional explicit cache directory; empty uses the standard Hugging Face cache.
ENGINEERING_RAG_EMBEDDING_CACHE_DIR=
ENGINEERING_RAG_EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# The smoke CLI defaults to offline model-cache access; no automatic model download.
