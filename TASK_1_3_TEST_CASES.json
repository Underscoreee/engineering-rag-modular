{
  "test_suite_id": "engineering-rag-task1.3-complex-tables-v2.4",
  "purpose": "MinerU-based engineering standard table reconstruction, layout, cross-page merge and frozen schema safety",
  "source_policy": {
    "local_only": true,
    "do_not_default_parse_full_document": true,
    "public_schema_is_frozen": "2.4"
