    "expected_original_pdf_pages": 441,
    "source_pdf_sha256": "43048a647d595fc8e16545851491bab82d3df851b91fe227ba2f7f84f5b64682"
  },
  "real_candidates_are_not_ground_truth": true,
  "real_cases": [
    {
